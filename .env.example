# SKED Environment Variables
# Copy this file to .env.local and fill in the values.

# === Supabase (required) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Auth (required) ===
AUTH_SECRET=your-secret-at-least-32-chars-long

# === Command Center access (required for /admin) ===
# Emails allowed to hold the super_admin platform role. Comma-separated.
# Without this, /admin answers 404 for every signed-in user unless their
# app_metadata.platform_role is already 'super_admin'
# (see scripts/promote-super-admin.mjs).
SUPER_ADMIN_EMAIL=owner@yourcompany.com

# === App (optional, defaults to localhost) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Resend (email) — optional during dev ===
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@sked.space

# === Semaphore (SMS) — optional ===
SEMAPHORE_API_KEY=your-api-key
SEMAPHORE_SENDER_NAME=SKED

# === Payment Provider (optional) ===
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_xxxxx
PAYMONGO_PUBLIC_KEY=pk_xxxxx

# === Sentry (error tracking) — optional ===
SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxxxx
SENTRY_ORG=sked
SENTRY_PROJECT=sked

# === PostHog (analytics) — optional ===
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === Google Calendar Sync — optional ===
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
